@using System.Globalization

@model KidEarn.Web.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Кабінет дитини";
}

<div class="container py-4">
    <!-- Привітання та статус -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Привіт, @Model.ChildName! 👋</h2>
            <p class="text-muted">Ось твої фінансові результати та успіхи в навчанні</p>
        </div>
        <div class="text-end">
            <span class="badge bg-primary fs-6 px-3 py-2">
                Коефіцієнт тижня: <strong>x@(Model.CurrentMultiplier.ToString("F2", CultureInfo.InvariantCulture))</strong>
            </span>
        </div>
    </div>

    <!-- Фінансові віджети -->
    <div class="row g-4 mb-4">
        <!-- Основний баланс -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100 bg-light">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted text-uppercase">Основний гаманець</h6>
                    <h2 class="card-title text-success fw-bold">@Model.NutBalance.ToString("F2") <small class="fs-6">Nut</small></h2>
                    <p class="card-text small text-muted">Доступно для витрат або переказу на депозит</p>
                </div>
            </div>
        </div>

        <!-- Ставка на день -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100 bg-light">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted text-uppercase">Денна винагорода</h6>
                    <h2 class="card-title text-primary fw-bold">@Model.EffectiveDailyAllowance.ToString("F2") <small class="fs-6">Nut/день</small></h2>
                    <p class="card-text small text-muted">
                        Базова ставка @Model.DailyBaseAllowance.ToString("F2") × @Model.CurrentMultiplier.ToString("F2")
                    </p>
                </div>
            </div>
        </div>

        <!-- Скарбничка / Депозит -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100 bg-light">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted text-uppercase">Депозитний рахунок</h6>
                    <h2 class="card-title text-warning fw-bold">@Model.DepositBalance.ToString("F2") <small class="fs-6">Nut</small></h2>
                    <p class="card-text small text-muted">
                        Ставка накопичення: <strong>@Model.DepositInterestRate.ToString("F1")%</strong>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Таблиця оцінок -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="card-title mb-0 fw-bold">Останні оцінки за період</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Предмет</th>
                            <th class="text-center">Бал</th>
                            <th>Дата</th>
                            <th>Коментар</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentGrades.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">Оцінок за поточний період ще немає.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var grade in Model.RecentGrades)
                            {
                                <tr>
                                    <td class="fw-semibold">@grade.SubjectName</td>
                                    <td class="text-center">
                                        <span class="badge @(grade.Value >= 10 ? "bg-success" : grade.Value >= 7 ? "bg-info text-dark" : "bg-warning text-dark") fs-6 px-3">
                                            @grade.Value
                                        </span>
                                    </td>
                                    <td>@grade.DateReceived.ToString("dd.MM.yyyy")</td>
                                    <td class="text-muted">@(grade.Comment ?? "—")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
