@model KidEarn.Web.ViewModels.CreateChildViewModel

@{
    ViewData["Title"] = "Реєстрація дитини";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 fw-bold">Новий профіль дитини</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CreateChild" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-semibold"></label>
                                <input asp-for="FirstName" class="form-control" placeholder="Анна" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-semibold"></label>
                                <input asp-for="LastName" class="form-control" placeholder="Коваленко" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                            <input asp-for="PhoneNumber" class="form-control" type="tel" placeholder="+380971112233" />
                            <div class="form-text">Цей номер дитина використовуватиме для входу у свій кабінет.</div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PinCode" class="form-label fw-semibold"></label>
                            <input asp-for="PinCode" class="form-control" type="password" placeholder="Наприклад: 1234" />
                            <span asp-validation-for="PinCode" class="text-danger small"></span>
                        </div>

                        <hr class="my-4" />

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="DailyBaseAllowance" class="form-label fw-semibold"></label>
                                <input asp-for="DailyBaseAllowance" class="form-control" type="number" step="0.50" />
                                <span asp-validation-for="DailyBaseAllowance" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DepositInterestRatePercent" class="form-label fw-semibold"></label>
                                <input asp-for="DepositInterestRatePercent" class="form-control" type="number" step="0.1" />
                                <span asp-validation-for="DepositInterestRatePercent" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">Скасувати</a>
                            <button type="submit" class="btn btn-primary px-4">Створити профіль</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
