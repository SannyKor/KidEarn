@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model KidEarn.Web.ViewModels.CreateGradeViewModel

@{
    ViewData["Title"] = "Додати оцінку";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title mb-0 fw-bold">Нова оцінка</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Grades" asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ChildId" />

                        <!-- Валідаційне резюме -->
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Вибір предмета -->
                        <div class="mb-3">
                            <label asp-for="SubjectId" class="form-label fw-semibold"></label>
                            <select asp-for="SubjectId" asp-items="Model.AvailableSubjects" class="form-select">
                                <option value="">-- Оберіть предмет із списку --</option>
                            </select>
                            <span asp-validation-for="SubjectId" class="text-danger small"></span>
                        </div>

                        <!-- Оцінка -->
                        <div class="mb-3">
                            <label asp-for="Value" class="form-label fw-semibold"></label>
                            <input asp-for="Value" class="form-control" type="number" min="1" max="12" placeholder="Наприклад: 11" />
                            <span asp-validation-for="Value" class="text-danger small"></span>
                        </div>

                        <!-- Дата -->
                        <div class="mb-3">
                            <label asp-for="DateReceived" class="form-label fw-semibold"></label>
                            <input asp-for="DateReceived" class="form-control" type="date" />
                            <span asp-validation-for="DateReceived" class="text-danger small"></span>
                        </div>

                        <!-- Коментар -->
                        <div class="mb-4">
                            <label asp-for="Comment" class="form-label fw-semibold"></label>
                            <textarea asp-for="Comment" class="form-control" rows="2" placeholder="Наприклад: Контрольна з алгебри"></textarea>
                            <span asp-validation-for="Comment" class="text-danger small"></span>
                        </div>

                        <!-- Кнопки дій -->
                        <div class="d-flex justify-content-between">
                            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">
                                Назад до кабінету
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                Зберегти оцінку
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}