<ul class="navbar-nav ms-auto align-items-center">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item me-3">
            <span class="navbar-text fw-semibold text-dark">
                👤 @User.Identity.Name
            </span>
        </li>
        <li class="nav-item">
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-danger">Вийти</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item me-2">
            <a class="btn btn-sm btn-outline-primary" asp-controller="Account" asp-action="Login">Увійти</a>
        </li>
        <li class="nav-item">
            <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="RegisterParent">Створити сім'ю</a>
        </li>
    }
</ul>